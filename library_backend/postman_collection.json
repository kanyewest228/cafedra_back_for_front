            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_id\": null,\n  \"category\": \"question\",\n  \"author\": \"Алексей К.\",\n  \"text\": \"Планируется ли продолжение арки с древним артефактом?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}/comments",
