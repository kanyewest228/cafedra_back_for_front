{
  "info": {
    "_postman_id": "a5e9f8c0-3b21-4f81-9b12-52sprint0001",
    "name": "Books & Scripts Platform API (Sprint 52)",
    "description": "Postman-коллекция для тестирования REST API платформы совместного написания сценариев и книг (Laravel 13).\n\nВключает:\n- Пагинацию книг по 8 элементов\n- Поиск и CRUD для книг\n- Рекурсивное дерево комментариев\n- Фильтрацию комментариев по разделам (lore, alternative, edit, question)\n- Добавление корневых комментариев и вложенных ответов (children)\n- Удаление веток",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "101",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Books (Книги)",
      "item": [
        {
          "name": "1. Список книг (пагинация по 8 штук)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books?page=1&per_page=8",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Номер страницы"
                },
                {
                  "key": "per_page",
                  "value": "8",
                  "description": "Количество книг на страницу (по ТЗ: 8)"
                }
              ]
            },
            "description": "Получение списка книг с пагинацией по 8 элементов."
          },
          "response": []
        },
        {
          "name": "2. Список книг (Страница 2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books?page=2&per_page=8",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "per_page",
                  "value": "8"
                }
              ]
            },
            "description": "Получение второй страницы списка книг."
          },
          "response": []
        },
        {
          "name": "3. Поиск книг по названию / автору",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books?search=каштака",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "search",
                  "value": "каштака",
                  "description": "Поисковый запрос"
                }
              ]
            },
            "description": "Поиск по ключевым словам среди заголовков, авторов и описаний."
          },
          "response": []
        },
        {
          "name": "4. Детальная информация о книге",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            },
            "description": "Получение полных данных о конкретной книге, включая full_text."
          },
          "response": []
        },
        {
          "name": "5. Создать книгу",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Хроники пустоты\",\n  \"author\": \"Михаил Булгаков\",\n  \"description\": \"Мистический роман о событиях в весенней Москве.\",\n  \"full_text\": \"В час жаркого весеннего заката на Патриарших прудах появились двое граждан...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            },
            "description": "Создание новой книги в системе."
          },
          "response": []
        },
        {
          "name": "6. Обновить книгу",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тени забытого мира (2-е издание)\",\n  \"description\": \"Обновленное расширенное описание сюжета.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            },
            "description": "Частичное или полное обновление данных книги."
          },
          "response": []
        },
        {
          "name": "7. Удалить книгу",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            },
            "description": "Удаление книги и каскадное удаление всех связанных комментариев."
          },
          "response": []
        }
      ]
    },
    {
